# Server-only API origin. No /api prefix, credentials, query or fragment.
# Vercel: https://your-api.onrender.com
API_URL=http://localhost:8080
# Server-only; same exclusive random secret (at least 32 bytes) in Next and API.
# Required on Vercel/production; never use a NEXT_PUBLIC prefix.
API_PROXY_SECRET=
# Public OAuth Web Client ID; must match GOOGLE_CLIENT_ID in the API.
# Empty disables Google while leaving local login available.
# Never add GOOGLE_CLIENT_SECRET or expose API_PROXY_SECRET to client code.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
